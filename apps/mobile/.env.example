# Copia este archivo como .env (Expo lo lee al arrancar Metro).

# Emulador o telefono por USB con `adb reverse tcp:3000 tcp:3000`:
EXPO_PUBLIC_API_URL=http://localhost:3000

# iPhone o telefono por WiFi: usa la IP de tu computadora en la misma red.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# API compartida en Railway:
# EXPO_PUBLIC_API_URL=https://tu-api.up.railway.app

# Solo para el APK (EAS Build). En Expo Go no hace falta.
# GOOGLE_MAPS_API_KEY=
