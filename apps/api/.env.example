# Copia este archivo como .env y ajusta los valores.
# Con docker compose (raiz del repo) estos valores funcionan tal cual.

PORT=3000
HOST=0.0.0.0

# mysql://usuario:contrasena@host:puerto/base
DATABASE_URL=mysql://wipi:wipi@localhost:3306/wipi

# Base en la nube (Aiven): pega su "Service URI" tal cual, con ?ssl-mode=REQUIRED.
# DATABASE_URL=mysql://avnadmin:CONTRASENA@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# Opcional: certificado CA de Aiven (texto PEM) para validar el servidor.
# DATABASE_CA=

# Cadena larga y aleatoria. En la nube usa un valor distinto.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
