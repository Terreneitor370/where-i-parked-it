# Copia este archivo como .env (Expo lo lee al arrancar Metro).
# Con `adb -s emulator-5556 reverse tcp:3000 tcp:3000` el emulador del reloj
# ve la API de tu computadora como localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Para la API compartida en Railway:
# EXPO_PUBLIC_API_URL=https://tu-api.up.railway.app
